{
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "receipts-hook codex session", "timeout": 10 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "receipts-hook codex prompt", "timeout": 10 }] }],
    "PostToolUse": [{ "matcher": "^Bash$", "hooks": [{ "type": "command", "command": "receipts-hook codex ledger", "timeout": 10 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "receipts-hook codex stop", "timeout": 15 }] }]
  }
}
