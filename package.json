{
  "name": "@receipts/cli",
  "version": "0.1.0",
  "description": "No claim without proof: deterministic verification of AI coding agents' final messages.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "receipts": "dist/cli/main.js",
    "receipts-hook": "dist/cli/hook.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "rules",
    "skill",
    "adapters",
    "grammars"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-include='dist/core/**' --test-coverage-exclude='dist/core/testutil.js' --test-coverage-exclude='dist/**/*.test.js' 'dist/**/*.test.js'",
    "bench:perf": "node scripts/perf.mjs"
  },
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tree-sitter-wasms": "^0.1.13",
    "typescript": "^7.0.2"
  }
}